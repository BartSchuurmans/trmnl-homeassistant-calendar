#!/command/with-contenv sh
# Renders recipe screens before the TRMNL asks for them (see prerender.php), once a
# minute: s6 starts this again after it exits. Off with the app's "prerender" option, or
# LARAPAPER_LOCAL_PRERENDER=0 (the end-to-end test runs it by hand), which wins.
# shellcheck disable=SC2016 # PHP code, not shell expansions
enabled="${LARAPAPER_LOCAL_PRERENDER:-$(php -r '$o = json_decode(@file_get_contents($argv[1]), true) ?: [];
    echo ($o["prerender"] ?? true) ? "1" : "0";' "${DATA_DIR:-/data}/options.json")}"
if [ "$enabled" = 0 ]; then
    exec sleep infinity
fi
cd /var/www/html || exit 1
# As www-data, like PHP-FPM: files it creates (screens, a first laravel.log) must stay
# writable for the web app. The container itself runs as root (see the Dockerfile).
if [ "$(id -u)" = 0 ]; then
    /command/s6-setuidgid www-data php /opt/larapaper-local/prerender.php
else
    php /opt/larapaper-local/prerender.php
fi
exec sleep 60
