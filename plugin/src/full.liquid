{% comment %}
  Rolling month layout. Fork of usetrmnl/plugins lib/calendars/_full_month.html.erb
  (event_layout == 'rolling_month'), fed by ICS feeds or Home Assistant calendar
  entities instead of Google Calendar. CSS + JS live in shared.liquid, which LaraPaper
  prepends.
  The markup starts at the layout: TRMNL and LaraPaper wrap it in the view div.

  Settings live under trmnl.plugin_settings.custom_fields_values (same path on TRMNL
  cloud and LaraPaper). The polled payload is handed to the browser as-is; the JS in
  shared.liquid turns ICS and HA events into FullCalendar events (the Ruby side of upstream,
  Calendar::Helper#fullcalendar_events_json, is not open source).
{% endcomment %}
{% assign s = trmnl.plugin_settings.custom_fields_values %}
{% assign time_zone = s.time_zone | default: trmnl.user.time_zone_iana | default: "UTC" %}
{% assign locale = s.locale | default: "en" | strip %}
{% comment %} ICS feeds replace the HA entities when set (see polling_url in settings.yml) {% endcomment %}
{% assign source = "ha" %}{% if s.ics_urls contains "/" %}{% assign source = "ics" %}{% endif %}
{% comment %}
  LaraPaper passes the payload as `data`: one calendar's response, or {IDX_0: ..., IDX_1: ...}
  for several. TRMNL and trmnlp have no `data` for several URLs, only IDX_0, IDX_1, ... at the
  top level, so collect those (up to ten; unused ones come out as null, which the JS reads as empty calendars).
{% endcomment %}
{% assign events_json = data | json %}
{% if IDX_0 %}{% unless data %}{% capture events_json %}{
    "IDX_0": {{ IDX_0 | json }}, "IDX_1": {{ IDX_1 | json }}, "IDX_2": {{ IDX_2 | json }}, "IDX_3": {{ IDX_3 | json }}, "IDX_4": {{ IDX_4 | json }},
    "IDX_5": {{ IDX_5 | json }}, "IDX_6": {{ IDX_6 | json }}, "IDX_7": {{ IDX_7 | json }}, "IDX_8": {{ IDX_8 | json }}, "IDX_9": {{ IDX_9 | json }}
}{% endcapture %}{% endunless %}{% endif %}

{% if s.dither_greys == "yes" %}
  {% comment %}
    LaraPaper only dithers 1-/2-bit output when the page has an img with class
    "image-dither" (ImageGenerationService::markupContainsDitherImage). This hidden
    pixel is that switch; 4-bit output is dithered regardless.
  {% endcomment %}
  <img class="image-dither" src="data:image/gif;base64,R0lGODlhAQABAIAAAP///wAAACH5BAEAAAAALAAAAAABAAEAAAICRAEAOw==" alt="" style="display:none">
{% endif %}
<div class="layout layout--col layout--stretch">
  <div id="calendar-full-month"
       class="trmnl-calendar trmnl-calendar--month{% if s.highlight_today != 'no' %} highlight-today{% endif %}{% if s.shade_weekends != 'no' %} shade-weekends{% endif %}{% if s.fade_past_events != 'no' %} fade-past{% endif %}{% if s.dither_greys == 'yes' %} dither-greys{% endif %}"
       data-events="{{ events_json | escape }}"
       data-calendar-config='{
         "timeZoneName": {{ time_zone | json | escape }},
         "nowUtc": {{ trmnl.system.timestamp_utc | default: 0 }},
         "source": "{{ source }}",
         "calendarEntities": {% if source == "ics" %}""{% else %}{{ s.calendars | default: "" | json | escape }}{% endif %},
         "calendarPrefixes": {{ s.calendar_labels | default: "" | json | escape }},
         "calendarColors": {{ s.calendar_colors | default: "" | json | escape }},
         "ignoredPhrases": {{ s.ignored_phrases | default: "" | json | escape }},
         "ignoredPhrasesExactMatch": {{ s.ignored_phrases_exact_match | default: "" | json | escape }},
         "includePastEvents": {% if s.include_past_events == "no" %}false{% else %}true{% endif %},
         "rollingAdvancement": {{ s.rolling_advancement | default: "week" | json | escape }},
         "weekOverflow": {{ s.week_overflow | default: "fewer_weeks" | json | escape }},
         "firstDay": {{ s.first_day | default: 1 | plus: 0 }},
         "hour12": {% if s.time_format == "am/pm" %}true{% else %}false{% endif %},
         "displayEventTime": {% if s.include_event_time == "no" %}false{% else %}true{% endif %},
         "displayEventEnd": {% if s.display_event_end == "no" %}false{% else %}true{% endif %},
         "weekNumbers": {% if s.show_week_numbers == "yes" %}true{% else %}false{% endif %},
         "shadeWeekends": {% if s.shade_weekends == "no" %}false{% else %}true{% endif %},
         "ditherGreys": {% if s.dither_greys == "yes" %}true{% else %}false{% endif %},
         "locale": {{ locale | json | escape }}
       }'></div>
</div>
{% if s.month_header == "yes" %}
  <div class="title_bar">
    <img class="image image--adaptive" alt="" src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='2'%3E%3Crect x='3' y='5' width='18' height='16' rx='2'/%3E%3Cpath d='M3 10h18M8 3v4M16 3v4'/%3E%3C/svg%3E">
    <span class="title">{{ trmnl.plugin_settings.instance_name | default: "Calendar" | escape }}</span>
    <span class="instance" data-calendar-range></span>
  </div>
{% endif %}
