{% comment %}
  Shared CSS + JS. Fork of usetrmnl/plugins lib/calendars/_common.html.erb, trimmed to
  what the month layouts use, plus the ICS / Home Assistant → FullCalendar event mapping.

  Upstream loads a private FullCalendar build from trmnl.com; the open-source build is
  enough for dayGrid. It loads from /rolling-month-calendar/..., which the LaraPaper (local) app
  in this repo serves so rendering needs no internet, and falls back to jsDelivr on
  any other server. The stylesheets upstream links (plugins/calendars,
  plugins/calendars_full_month) aren't published, so the styles below are a
  re-creation.
{% endcomment %}
{% assign cal_locale = trmnl.plugin_settings.custom_fields_values.locale | default: "en" | strip | downcase %}
<script src="/rolling-month-calendar/fullcalendar/6.1.21/index.global.min.js"></script>
<script>window.FullCalendar || document.write('<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.21/index.global.min.js"><\/script>');</script>
{% if cal_locale != "en" and cal_locale != "" %}
<script src="/rolling-month-calendar/fullcalendar/6.1.21/locales-all.global.min.js"></script>
<script>(window.FullCalendar && FullCalendar.globalLocales && FullCalendar.globalLocales.length) || document.write('<script src="https://cdn.jsdelivr.net/npm/@fullcalendar/core@6.1.21/locales-all.global.min.js"><\/script>');</script>
{% endif %}

<style>
  /* Fonts, text sizes and greys come from the TRMNL framework: the JS below puts
     text--* and bg--gray-* classes on FullCalendar's elements, which gives Inter at
     the device's scale on the TRMNL X and pixel fonts plus dither patterns on 1-/2-bit
     screens. This sheet only shapes FullCalendar's grid; sizes follow --ui-scale. */
  .trmnl-calendar {
    --cal-u: var(--ui-scale, 1);
    --cal-line: max(1px, round(down, calc(var(--cal-u) * 1.4px), 1px)); /* 1px, 2px on the X */
    flex: 1 1 auto;
    align-self: stretch;
    min-height: 0;
    width: 100%;
    color: var(--black);
    --fc-border-color: var(--black);
    --fc-page-bg-color: var(--white);
    --fc-neutral-bg-color: transparent;
    --fc-today-bg-color: transparent;
    --fc-event-bg-color: var(--black);
    --fc-event-border-color: var(--black);
    --fc-event-text-color: var(--white);
    --fc-small-font-size: 1em;
  }

  /* e-ink: no scrollbars, no hover states, no links */
  .trmnl-calendar .fc-scroller { overflow: hidden !important; }
  .trmnl-calendar a { color: inherit; text-decoration: none; }
  .trmnl-calendar .fc-event:hover,
  .trmnl-calendar .fc-daygrid-dot-event:hover { background: none; }

  /* grid: thin grey lines like upstream; 1-/2-bit can't print grey lines, so dotted black */
  .trmnl-calendar th, .trmnl-calendar td { border: 1px solid var(--gray-50); }
  .screen--1bit .trmnl-calendar th, .screen--1bit .trmnl-calendar td,
  .screen--2bit .trmnl-calendar th, .screen--2bit .trmnl-calendar td { border-style: dotted; border-color: var(--black); }
  .trmnl-calendar .fc-scrollgrid,
  .trmnl-calendar .fc-scrollgrid-section > * { border-width: 0; }
  .trmnl-calendar .fc-col-header-cell { border-top-width: 0; }
  .trmnl-calendar .fc-col-header-cell-cushion {
    display: block;
    padding: calc(2px * var(--cal-u)) calc(6px * var(--cal-u));
    font-weight: 700;
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .trmnl-calendar .fc-daygrid-body tr:last-child > td { border-bottom-width: 0; }
  .trmnl-calendar .fc-daygrid-body td:first-child,
  .trmnl-calendar .fc-col-header-cell:first-child { border-left-width: 0; }
  .trmnl-calendar .fc-daygrid-body td:last-child,
  .trmnl-calendar .fc-col-header-cell:last-child { border-right-width: 0; }

  /* day number, right aligned; month label sits left of the number on the 1st */
  .trmnl-calendar .fc-daygrid-day-top { align-items: center; }
  .trmnl-calendar .fc-daygrid-day-top.trmnl-has-month-label { flex-direction: row; justify-content: flex-end; align-items: baseline; }
  /* font-size 0 drops the link's own (browser default) line box, so the number's text starts
     right below the padding, where the week number's does too */
  .trmnl-calendar .fc-daygrid-day-number { padding: calc(3px * var(--cal-u)) calc(4px * var(--cal-u)) calc(1px * var(--cal-u)); font-size: 0; }
  .trmnl-calendar .trmnl-day-number {
    display: inline-block;
    min-width: 1.5em;
    padding: 0 0.3em;
    border-radius: 999px;
    text-align: center;
  }
  /* today: its weekday in the header row inverted, and the day number in a black pill */
  .trmnl-calendar.highlight-today .fc-col-header-cell.trmnl-today-col { background: var(--black) !important; color: var(--white); }
  .trmnl-calendar.highlight-today .fc-day-today .trmnl-day-number { background: var(--black); color: var(--white); font-weight: 700; }
  .trmnl-calendar .fc-daygrid-month-start.trmnl-mid-month { font-weight: 400; }
  .trmnl-calendar .trmnl-month-label {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    padding-left: calc(4px * var(--cal-u));
  }

  /* events */
  .trmnl-calendar .fc-daygrid-event { margin-top: calc(2px * var(--cal-u)); }
  .trmnl-calendar .fc-daygrid-block-event {
    border: 0;
    border-radius: calc(2px * var(--cal-u));
    background: transparent; /* the fill goes on .fc-event-main, see eventDidMount */
    overflow: hidden;
  }
  .trmnl-calendar .fc-daygrid-block-event .fc-event-main {
    height: 100%;
    padding: calc(1px * var(--cal-u)) calc(4px * var(--cal-u));
    color: var(--black);
  }
  .trmnl-calendar .fc-daygrid-block-event .fc-event-main-frame { flex-direction: column-reverse; align-items: stretch; }
  .trmnl-calendar .fc-daygrid-event,
  .trmnl-calendar .fc-daygrid-event * { line-height: 1.25; }
  .trmnl-calendar .fc-event-time { margin: 0; font-weight: 400; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  /* every title, timed or all-day, bar or fill, band or single day: wraps over at most two
     lines, then ends in an ellipsis */
  .trmnl-calendar .fc-daygrid-event .fc-event-title {
    font-weight: 400;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    white-space: normal;
    overflow-wrap: anywhere;
  }

  /* Timed events without a calendar colour, as upstream draws them (and single-day
     all-day events the same way, without the time): a grey bar on the
     left (FullCalendar's dot, restyled), the title (up to two lines, see above), and the
     time below it in grey. */
  .trmnl-calendar .fc-daygrid-dot-event {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: calc(4px * var(--cal-u));
    align-items: start;
    padding: 0;
    margin-left: calc(3px * var(--cal-u));
    margin-right: calc(3px * var(--cal-u));
    color: var(--black);
  }
  .trmnl-calendar .fc-daygrid-event-dot {
    grid-row: 1 / span 2;
    align-self: stretch;
    width: calc(3px * var(--cal-u));
    height: auto; /* FullCalendar sizes the dot with a fixed height */
    box-sizing: border-box;
    margin: 0;
    border: 0;
    border-radius: calc(2px * var(--cal-u));
  }
  .trmnl-calendar .fc-daygrid-dot-event .fc-event-title { grid-column: 2; grid-row: 1; }
  .trmnl-calendar .fc-daygrid-dot-event .fc-event-time { grid-column: 2; grid-row: 2; }
  .trmnl-calendar .fc-daygrid-dot-event .fc-event-title { font-weight: 700; }
  /* filled events (multi-day, or any from a coloured calendar) get a bold title to match */
  .trmnl-calendar .fc-daygrid-block-event .fc-event-title { font-weight: 700; }
  .trmnl-calendar .fc-daygrid-day-events { margin-bottom: calc(3px * var(--cal-u)); }
  /* "+N more" (Busy weeks setting), at the events' size */
  .trmnl-calendar .fc-daygrid-day-bottom { font-size: inherit; } /* FullCalendar shrinks it to .85em */
  .trmnl-calendar .fc-daygrid-more-link { font-weight: 700; font-size: var(--fc-small-font-size); margin-left: calc(3px * var(--cal-u)); }
  .trmnl-calendar .fc-daygrid-week-number { background: none; color: inherit; font-weight: 700; padding: calc(3px * var(--cal-u)) calc(4px * var(--cal-u)) 0; }
  /* the week number sits top-left of the week's first cell; keep a month label clear of it */
  .trmnl-calendar .fc-daygrid-day-frame:has(.fc-daygrid-week-number) .trmnl-month-label { padding-left: 2.6em; }

  /* "Fade past events": events that are over recede. Only where greys print as greys (4-bit,
     or the "Dither" setting); a 1-/2-bit pattern would make them unreadable instead.
     invert/brightness/invert mixes every pixel 40% towards white, like 60% opacity on a
     white cell; TRMNL's publish check rejects the opacity property. */
  .screen--4bit .trmnl-calendar.fade-past .fc-event-past,
  .trmnl-calendar.fade-past.dither-greys .fc-event-past { filter: invert(1) brightness(0.6) invert(1); }

  /* "Dither" setting: skip the framework's per-depth greys (patterns on 1-/2-bit) and
     paint the raw palette greys; LaraPaper then dithers the whole screen. */
  .trmnl-calendar.dither-greys.shade-weekends .fc-daygrid-day.fc-day-sat,
  .trmnl-calendar.dither-greys.shade-weekends .fc-daygrid-day.fc-day-sun { background: var(--gray-75); }
  .trmnl-calendar.dither-greys.shade-weekends .fc-col-header-cell.fc-day-sat,
  .trmnl-calendar.dither-greys.shade-weekends .fc-col-header-cell.fc-day-sun { background: var(--gray-75); }
  .trmnl-calendar.dither-greys .trmnl-day-number.is-past,
  .trmnl-calendar.dither-greys .trmnl-month-label.is-past,
  .trmnl-calendar.dither-greys .fc-daygrid-week-number,
  .trmnl-calendar.dither-greys .fc-daygrid-dot-event .fc-event-time { color: var(--gray-30); }
  .trmnl-calendar.dither-greys .fc-daygrid-event-dot { background: var(--gray-50); }

  /* a white calendar colour has no edge on a white cell: outline it like the grid lines */
  .trmnl-calendar .trmnl-event--white { box-shadow: inset 0 0 0 1px var(--gray-50); }
  .screen--1bit .trmnl-calendar .trmnl-event--white,
  .screen--2bit .trmnl-calendar .trmnl-event--white { box-shadow: none; outline: 1px dotted var(--black); outline-offset: -1px; }

  /* patterned or dithered weekend cells make small text hard to read: back it with white */
  .screen--1bit .trmnl-calendar .trmnl-day-number,
  .screen--2bit .trmnl-calendar .trmnl-day-number,
  .screen--1bit .trmnl-calendar .trmnl-month-label,
  .screen--2bit .trmnl-calendar .trmnl-month-label,
  .screen--1bit .trmnl-calendar .fc-daygrid-dot-event,
  .screen--2bit .trmnl-calendar .fc-daygrid-dot-event { background-color: var(--white); }

  /* Narrow views (see trmnlInitCalendars): less space around events and day numbers, and
     titles wrap between words where they can, over up to three lines */
  .trmnl-calendar--narrow .fc-daygrid-dot-event { column-gap: calc(2px * var(--cal-u)); margin-left: calc(1px * var(--cal-u)); margin-right: 0; }
  .trmnl-calendar--narrow .fc-daygrid-event-dot { width: calc(2px * var(--cal-u)); }
  .trmnl-calendar--narrow .fc-daygrid-block-event .fc-event-main { padding: calc(1px * var(--cal-u)) calc(2px * var(--cal-u)); }
  .trmnl-calendar--narrow .fc-daygrid-event .fc-event-title { -webkit-line-clamp: 3; overflow-wrap: break-word; }
  .trmnl-calendar--narrow .fc-daygrid-day-number { padding-left: calc(2px * var(--cal-u)); padding-right: calc(2px * var(--cal-u)); }
  .trmnl-calendar--narrow .trmnl-day-number { min-width: 0; padding: 0 0.15em; }
  .trmnl-calendar--narrow .fc-day-today .trmnl-day-number { min-width: 1.5em; }
  .trmnl-calendar--narrow .trmnl-month-label { padding-left: calc(2px * var(--cal-u)); }

  .trmnl-calendar-error { font-weight: 700; }
</style>

<script>
  // Home Assistant REST (/api/calendars/<entity>) and server-parsed ICS feeds →
  // FullCalendar events.
  // Stands in for the closed-source Calendar::Helper of the native plugin and mirrors
  // the filtering of Plugins::GoogleCalendar#prepare_events.
  window.trmnlRollingCalendar = (function() {
    function splitList(value) {
      return String(value || '').split(',').map(function(v) { return v.trim(); }).filter(Boolean);
    }

    // Per-calendar lists (prefixes, colours) line up with the calendar entities by
    // position; "-" leaves a calendar without a value.
    function splitAligned(value) {
      return splitList(value).map(function(v) { return v === '-' ? '' : v; });
    }

    // A calendar colour is a framework palette token (black, white, gray-10..gray-75,
    // red, blue-40, ...), painted with its bg--* class so every screen gets its own
    // rendering (solid grey on 4-bit, dither pattern on 1-/2-bit, ink on colour panels),
    // or a hex colour, painted as-is.
    var HUES = 'red|orange|yellow|lime|green|cyan|blue|violet|purple|pink';
    var TOKEN = new RegExp('^(black|white|gray-(10|15|20|25|30|35|40|45|50|55|60|65|70|75)|(' + HUES + ')(-(10|15|20|25|30|35|40|45|50|55|60|65|70|75))?)$');
    var HEX = /^#([0-9a-f]{3}|[0-9a-f]{6})$/i;
    function parseColor(value) {
      var v = String(value || '').trim().toLowerCase().replace(/^bg--/, '');
      if (TOKEN.test(v)) return { token: v };
      if (HEX.test(v)) return { hex: v };
      return null;
    }

    // LaraPaper parses an ICS feed into { ical: [{ SUMMARY, DTSTART, DTEND, ... }] }, with
    // recurring events expanded, events from 7 days back to 30 days ahead, and every date
    // as an ISO string with an offset. The all-day flag doesn't survive: all-day events
    // are the ones running midnight to midnight, and their dates are read as written.
    // Turned into HA's shape here, so the rest treats both sources alike.
    var DATE_ONLY = /^\d{4}-\d{2}-\d{2}$/;
    var MIDNIGHT = /^\d{4}-\d{2}-\d{2}T00:00(:00(\.0+)?)?(Z|[+-]\d{2}:?\d{2})?$/;
    function fromIcal(ev) {
      if (!ev || typeof ev !== 'object' || !ev.DTSTART) return null;
      if (String(ev.STATUS || '').toUpperCase() === 'CANCELLED') return null;
      var start = String(ev.DTSTART), end = ev.DTEND ? String(ev.DTEND) : null;
      var allDay = DATE_ONLY.test(start) || (MIDNIGHT.test(start) && (!end || MIDNIGHT.test(end)) && (!end || end.slice(0, 10) > start.slice(0, 10)));
      var text = function(v) { return v == null ? '' : Array.isArray(v) ? v.join(' ') : String(v); };
      return {
        start: allDay ? { date: start.slice(0, 10) } : { dateTime: start },
        end: end ? (allDay ? { date: end.slice(0, 10) } : { dateTime: end }) : null,
        summary: text(ev.SUMMARY) || null,
        description: text(ev.DESCRIPTION),
        location: text(ev.LOCATION)
      };
    }

    // TRMNL's native calendar plugins (Google, Outlook, Apple, ...) in data mode: parsed
    // events with start_full/end_full (a date for all-day events, else a time with offset;
    // usetrmnl/plugins lib/google_calendar/google_calendar.rb#event_hash).
    function fromNative(ev) {
      if (!ev || typeof ev !== 'object' || !ev.start_full) return null;
      if (String(ev.status || '').toLowerCase() === 'cancelled') return null;
      var start = String(ev.start_full), end = ev.end_full ? String(ev.end_full) : null;
      var allDay = ev.all_day === true || DATE_ONLY.test(start);
      return {
        start: allDay ? { date: start.slice(0, 10) } : { dateTime: start },
        end: end ? (allDay ? { date: end.slice(0, 10) } : { dateTime: end }) : null,
        summary: ev.summary || null,
        description: ev.description || '',
        location: ev.location || ''
      };
    }

    // LaraPaper stores one polled URL as its JSON (a bare list becomes { data: [...] }, and
    // is also spread into the top-level `data`) and several as { IDX_0: ..., IDX_1: ... }.
    function payloadToCalendars(payload) {
      if (Array.isArray(payload)) return [{ events: payload }];
      if (!payload || typeof payload !== 'object') return [];
      var idxKeys = Object.keys(payload).filter(function(k) { return /^IDX_\d+$/.test(k); });
      if (idxKeys.length) {
        return idxKeys
          .sort(function(a, b) { return parseInt(a.slice(4), 10) - parseInt(b.slice(4), 10); })
          .map(function(k) { return payloadToCalendars(payload[k])[0] || { events: [] }; });
      }
      if (Array.isArray(payload.ical)) return [{ events: payload.ical.map(fromIcal).filter(Boolean) }];
      if (Array.isArray(payload.events)) return [{ events: payload.events.map(fromNative).filter(Boolean) }];
      if (payload.data && Array.isArray(payload.data.events)) return payloadToCalendars(payload.data);
      if (Array.isArray(payload.data)) return [{ events: payload.data }];
      if (payload.error || payload.message) return [{ events: [], error: payload.error || payload.message }];
      return [];
    }

    // HA sends timed events as ISO strings in HA's own offset. The renderer's clock is
    // whatever the BYOS container runs in, so convert to wall-clock time in the chosen
    // zone and give FullCalendar zone-less strings with timeZone: 'UTC'.
    function wallClock(dateOrIso, timeZone) {
      var d = dateOrIso instanceof Date ? dateOrIso : new Date(dateOrIso);
      try {
        var parts = {};
        new Intl.DateTimeFormat('en-US', {
          timeZone: timeZone, hourCycle: 'h23',
          year: 'numeric', month: '2-digit', day: '2-digit',
          hour: '2-digit', minute: '2-digit', second: '2-digit'
        }).formatToParts(d).forEach(function(p) { parts[p.type] = p.value; });
        return parts.year + '-' + parts.month + '-' + parts.day + 'T' + parts.hour + ':' + parts.minute + ':' + parts.second;
      } catch (e) {
        // unknown zone: keep HA's own wall-clock time
        return typeof dateOrIso === 'string' ? dateOrIso.slice(0, 19) : d.toISOString().slice(0, 19);
      }
    }

    function includesAny(text, phrases) {
      return phrases.some(function(p) { return (text || '').indexOf(p) !== -1; });
    }

    function isIgnored(ev, cfg) {
      var summary = ev.summary, description = ev.description || '';
      return includesAny(summary, cfg.ignoredPhrases) ||
        includesAny(description, cfg.ignoredPhrases) ||
        cfg.ignoredPhrasesExactMatch.indexOf((summary || '').trim()) !== -1 ||
        cfg.ignoredPhrasesExactMatch.indexOf(description.trim()) !== -1;
    }

    // all-day end dates are exclusive: a one-day event ends the next day (or has no end)
    function isSingleDay(start, end) {
      if (!end) return true;
      var d = new Date(start + 'T00:00:00Z');
      d.setUTCDate(d.getUTCDate() + 1);
      return end <= d.toISOString().slice(0, 10);
    }

    function toEvent(ev, prefix, color, cfg) {
      if (!ev || !ev.start) return null;
      var allDay = !!ev.start.date && !ev.start.dateTime;
      var start = allDay ? ev.start.date : wallClock(ev.start.dateTime, cfg.timeZoneName);
      var end = null;
      if (ev.end) end = allDay ? (ev.end.date || null) : (ev.end.dateTime ? wallClock(ev.end.dateTime, cfg.timeZoneName) : null);
      return {
        title: (prefix ? prefix + ' ' : '') + ev.summary,
        start: start,
        end: end,
        allDay: allDay,
        // coloured calendars fill every event, timed ones included, instead of a dot;
        // otherwise single-day all-day events get the timed events' bar ('list-item' is
        // FullCalendar's dot display) and only multi-day ones keep a filled band
        display: color ? 'block' : (allDay && isSingleDay(start, end) ? 'list-item' : 'auto'),
        extendedProps: { summary: ev.summary, description: ev.description || '', location: ev.location || '', color: color }
      };
    }

    function buildEvents(payload, cfg) {
      var today = cfg.today;
      var errors = [];
      var seen = {};
      var events = [];

      payloadToCalendars(payload).forEach(function(cal, i) {
        if (cal.error) errors.push((cfg.calendarEntities[i] || 'calendar ' + (i + 1)) + ': ' + cal.error);
        (cal.events || []).forEach(function(raw) {
          // private events without details have no summary; upstream calls them 'Busy'
          raw.summary = raw.summary || 'Busy';
          if (isIgnored(raw, cfg)) return;
          var ev = toEvent(raw, cfg.calendarPrefixes[i], parseColor(cfg.calendarColors[i]), cfg);
          if (!ev) return;

          if (!cfg.includePastEvents) {
            var endsAt = ev.end || ev.start;
            if (ev.allDay ? (ev.end ? endsAt <= today : endsAt < today) : endsAt <= today + 'T00:00:00') return;
          }

          // de-duplicate across calendars (family calendars often share an event), like upstream
          var key = [raw.summary, raw.description || '', ev.start, ev.end, ev.allDay].join('\u0000');
          if (seen[key]) return;
          seen[key] = true;
          events.push(ev);
        });
      });

      events.sort(function(a, b) { return a.start < b.start ? -1 : a.start > b.start ? 1 : 0; });
      return { events: events, errors: errors };
    }

    return { splitList: splitList, splitAligned: splitAligned, wallClock: wallClock, buildEvents: buildEvents };
  })();

  // The framework scales the whole screen with `transform: scale(var(--pixel-ratio))`
  // (1.8 on the TRMNL X, which it lays out at 1040x780). FullCalendar sizes its grid from
  // getBoundingClientRect(), which includes that transform, and writes the numbers back
  // as CSS lengths, so the grid came out 1.8x too big. Inside a calendar, report rects in
  // the calendar's own CSS pixels; everywhere else nothing changes.
  // Sizes come from offsetWidth/offsetHeight (layout sizes, which don't depend on where
  // the element sits): transformed rect sizes shift by a pixel with sub-pixel position,
  // and FullCalendar, which positions events by their measured heights, then never settles.
  (function() {
    if (Element.prototype.trmnlUnscaledRects) return;
    var rawRect = Element.prototype.getBoundingClientRect;
    Element.prototype.getBoundingClientRect = function() {
      var rect = rawRect.call(this);
      var root = this.closest ? this.closest('.trmnl-calendar') : null;
      if (!root || !root.offsetWidth) return rect;
      var scale = (root === this ? rect : rawRect.call(root)).width / root.offsetWidth;
      if (!scale || Math.abs(scale - 1) < 0.01) return rect;
      var width = this.offsetWidth !== undefined ? this.offsetWidth : rect.width / scale;
      var height = this.offsetHeight !== undefined ? this.offsetHeight : rect.height / scale;
      return new DOMRect(Math.round(rect.x / scale), Math.round(rect.y / scale), width, height);
    };
    Element.prototype.trmnlUnscaledRects = true;
  })();

  function isDark(color) {
    var m = /^#?([0-9a-f]{3}|[0-9a-f]{6})$/i.exec(String(color).trim());
    if (!m) return true;
    var h = m[1].length === 3 ? m[1].replace(/./g, '$&$&') : m[1];
    var r = parseInt(h.slice(0, 2), 16), g = parseInt(h.slice(2, 4), 16), b = parseInt(h.slice(4, 6), 16);
    return (0.299 * r + 0.587 * g + 0.114 * b) < 140;
  }

  // Shared initializer: bootstrap any .trmnl-calendar element with data-calendar-config JSON
  window.trmnlInitCalendars = function(root) {
    try {
      var scope = root || document;
      var nodes = scope.querySelectorAll('.trmnl-calendar:not([data-initialized])');
      nodes.forEach(function(node){
        var settings = {};
        try { settings = JSON.parse(node.getAttribute('data-calendar-config') || '{}'); } catch(e) { console.warn('Invalid calendar config', e); }
        var payload = null;
        try { payload = JSON.parse(node.getAttribute('data-events') || 'null'); } catch(e) { console.warn('Invalid calendar data', e); }

        var nowDate = settings.nowUtc ? new Date(settings.nowUtc * 1000) : new Date();
        settings.today = window.trmnlRollingCalendar.wallClock(nowDate, settings.timeZoneName).slice(0, 10);
        settings.calendarEntities = window.trmnlRollingCalendar.splitList(settings.calendarEntities);
        settings.calendarPrefixes = window.trmnlRollingCalendar.splitAligned(settings.calendarPrefixes);
        settings.calendarColors = window.trmnlRollingCalendar.splitAligned(settings.calendarColors);
        settings.ignoredPhrases = window.trmnlRollingCalendar.splitList(settings.ignoredPhrases);
        settings.ignoredPhrasesExactMatch = window.trmnlRollingCalendar.splitList(settings.ignoredPhrasesExactMatch);
        var built = window.trmnlRollingCalendar.buildEvents(payload, settings);

        // Everything below follows upstream _full_month + _common; `cfg` is the object
        // upstream renders server-side into data-calendar-config.
        var rollingMonthView = { type: 'dayGridMonth', duration: { weeks: 4 }, fixedWeekCount: false };
        if (settings.rollingAdvancement === 'day') rollingMonthView.dateAlignment = 'day';

        var cfg = {
          timeZone: 'UTC', // event strings are already wall-clock in settings.timeZoneName
          now: settings.today,
          headerToolbar: false, // the title bar (month_header) is the framework's .title_bar
          height: '100%',
          initialView: 'rollingMonth',
          initialDate: settings.today,
          // weekday names only, also on a one-week grid, where FullCalendar adds the date
          dayHeaderFormat: { weekday: 'short' },
          firstDay: settings.firstDay,
          eventTimeFormat: { hour: 'numeric', minute: '2-digit', hour12: settings.hour12, meridiem: false },
          views: { rollingMonth: rollingMonthView },
          events: built.events,
          displayEventTime: settings.displayEventTime,
          dayMaxEventRows: false,
          displayEventEnd: settings.displayEventEnd, // FullCalendar defaults this off in dayGrid
          weekNumbers: settings.weekNumbers,
          weekNumberCalculation: 'ISO',
          locale: settings.locale || 'en'
        };

        // Narrow views (the left or right half of a mashup) leave a few characters per day:
        // events show their start time only and tighter spacing (see .trmnl-calendar--narrow)
        if (node.offsetWidth < 600) {
          node.classList.add('trmnl-calendar--narrow');
          cfg.displayEventEnd = false;
        }

        // Base options shared by all calendars
        var baseOpts = {
          headerToolbar: false,
          locale: (cfg.locale || 'en')
        };

        // TRMNL framework classes on FullCalendar's elements: text--* picks the device's
        // font and size, bg--gray-* paints solid on 4-bit and a dither pattern on 1-/2-bit.
        // The "Dither" setting paints raw greys in CSS instead (see .dither-greys).
        var textSmall = function() { return ['text--small']; };
        var isWeekend = function(arg) { return arg.dow === 0 || arg.dow === 6; };
        var shadeClass = function(arg) {
          return (isWeekend(arg) && settings.shadeWeekends && !settings.ditherGreys) ? ['bg--gray-75'] : [];
        };
        var screenStyles = function() { return getComputedStyle(node.closest('.screen') || document.documentElement); };
        // 1-/2-bit screens print grey as a dot pattern, which breaks up the pixel fonts of the
        // events on top of it: there the weekend is shaded in the header row only.
        var patternedGreys = (parseInt(screenStyles().getPropertyValue('--framework-bit-depth'), 10) || 4) <= 2 && !settings.ditherGreys;
        // today's weekday column; the rolling grid always starts in today's week
        var todayDow = new Date(settings.today + 'T00:00:00Z').getUTCDay();
        baseOpts.dayHeaderClassNames = function(arg) {
          return ['text--small'].concat(arg.dow === todayDow ? ['trmnl-today-col'] : shadeClass(arg));
        };
        baseOpts.eventClassNames = function(arg) {
          var classes = ['text--small'];
          if (!arg.event.allDay) classes.push('trmnl-event--timed');
          if (arg.event.extendedProps.color) classes.push('trmnl-event--colored');
          return classes;
        };
        // Paint a palette token: its bg--* class (solid on 4-bit, dither pattern on 1-/2-bit),
        // or in "Dither" mode the raw colour, which LaraPaper then dithers with the rest.
        var paint = function(el, token, raw) {
          if (settings.ditherGreys) el.style.backgroundColor = raw;
          else el.classList.add('bg--' + token);
        };
        baseOpts.eventDidMount = function(info) {
          var color = info.event.extendedProps.color;
          var main = info.el.querySelector('.fc-event-main');
          var styles = screenStyles();

          if (!color) {
            // Upstream look: timed events get a grey bar and a grey time; multi-day
            // events a light grey fill. Single-day all-day events are drawn like timed
            // ones (see toEvent), with the bar and no time.
            var bar = info.el.querySelector('.fc-daygrid-event-dot');
            if (bar) paint(bar, 'gray-50', styles.getPropertyValue('--gray-50').trim());
            var time = info.el.querySelector('.fc-event-time');
            // (grey on 4-bit; a muted pattern on 1-/2-bit is hard to read, so solid black there)
            if (time && bar && !settings.ditherGreys && !patternedGreys) time.classList.add('text--muted');
            if (main) paint(main, 'gray-70', styles.getPropertyValue('--gray-70').trim());
            return;
          }

          // Calendar colour. FullCalendar paints the event's own background, which wins
          // over bg--* in the cascade, so the colour goes on the inner .fc-event-main.
          // Text is black or white by lightness on screens that print greys solid; on
          // 1-/2-bit the fill is a dither pattern, so black text with the framework's
          // contrast outline (text-stroke), like upstream's adaptiveEventStroke.
          main = main || info.el;
          var raw = color.hex || styles.getPropertyValue('--' + color.token).trim();
          if (color.hex) main.style.backgroundColor = raw;
          else paint(main, color.token, raw);
          if (color.token === 'white' || /^#f{3}(f{3})?$/i.test(raw)) main.classList.add('trmnl-event--white');
          var depth = parseInt(styles.getPropertyValue('--framework-bit-depth'), 10) || 4;
          var patterned = depth <= 2 && !settings.ditherGreys && color.token && color.token !== 'black' && color.token !== 'white';
          main.style.color = patterned || !isDark(raw) ? 'var(--black)' : 'var(--white)';
          if (patterned) main.classList.add('text-stroke', 'text-stroke--small');
        };
        baseOpts.moreLinkClassNames = textSmall;
        baseOpts.weekNumberClassNames = textSmall;
        baseOpts.dayCellClassNames = function(arg) { return patternedGreys ? [] : shadeClass(arg); };

        // Month/rolling-month: force numeric day number, but add a small month label
        if (node.classList.contains('trmnl-calendar--month')) {
          baseOpts.dayCellContent = function(arg) {
            try {
              var cls = 'trmnl-day-number text--small' + (arg.isPast ? ' is-past' + (settings.ditherGreys ? '' : ' text--muted') : '');
              return { html: '<span class="' + cls + '">' + arg.date.getUTCDate() + '</span>' };
            } catch (e) {
              return { html: '' };
            }
          };

          baseOpts.dayCellDidMount = function(arg) {
            try {
              var top = arg.el.querySelector('.fc-daygrid-day-top');
              var numEl = top && top.querySelector('.fc-daygrid-day-number');
              if (!top || !numEl) return;

              // Label the grid's first day and the 1st of a month when the grid spans two
              // months, as FullCalendar's month-start does. FullCalendar skips that on a
              // one-week grid (it hides day numbers there), so check it here and add its class.
              var gridStart = arg.view.currentStart;
              var gridEnd = new Date(arg.view.currentEnd.getTime() - 86400000);
              var spansMonths = gridStart.getUTCMonth() !== gridEnd.getUTCMonth() || gridStart.getUTCFullYear() !== gridEnd.getUTCFullYear();
              if (!spansMonths || (arg.date.getUTCDate() !== 1 && arg.date.getTime() !== gridStart.getTime())) return;
              numEl.classList.add('fc-daygrid-month-start');

              // short month name ("Sep"), which fits next to the number; some locales end it with a dot
              var monthName = arg.date.toLocaleDateString((cfg.locale || 'en'), { month: 'short', timeZone: 'UTC' }).replace(/\.$/, '');
              var label = document.createElement('span');
              // past days: the label is muted like the number next to it
              label.className = 'trmnl-month-label text--small' + (arg.isPast ? ' is-past' + (settings.ditherGreys ? '' : ' text--muted') : '');
              // FullCalendar bolds the number of every labelled day; keep that for the 1st
              // of a month, not for the grid's first day, which is labelled mid-month
              if (arg.date.getUTCDate() !== 1) numEl.classList.add('trmnl-mid-month');
              label.textContent = monthName;
              // Mark parent so CSS can align the pair to the right without :has()
              top.classList.add('trmnl-has-month-label');
              top.insertBefore(label, numEl);
            } catch (e) { /* ignore */ }
          };
        }

        // Rolling month fills the screen with as many whole weeks as actually fit.
        // Render the max first — 6, because only 6 weeks of events are fetched ahead
        // (polling_url in settings.yml); further rows would be blank. ICS feeds only hold
        // events up to 30 days ahead (see fromIcal), so there the grid stops at the last
        // whole week before that: a later day would look free when it may not be.
        var maxWeeks = 6;
        if (settings.source === 'ics') {
          var gridStart = new Date(settings.today + 'T00:00:00Z');
          if (settings.rollingAdvancement !== 'day') gridStart.setUTCDate(gridStart.getUTCDate() - (gridStart.getUTCDay() - settings.firstDay + 7) % 7);
          // the feed is cut 30 days after the poll, so day +29 is the last one complete
          var coveredDays = Math.round((Date.parse(settings.today + 'T00:00:00Z') - gridStart.getTime()) / 86400000) + 30;
          maxWeeks = Math.max(1, Math.min(6, Math.floor(coveredDays / 7)));
        }
        var rollingMonth = cfg.initialView === 'rollingMonth' && cfg.views && cfg.views.rollingMonth;
        // Capped rows stretch to share the height, so every week count "fits" and counting
        // them proves nothing — a capped grid keeps the weeks the server asked for.
        var expandWeeksToFillHeight = rollingMonth && !cfg.dayMaxEventRows;
        if (expandWeeksToFillHeight) { cfg.views.rollingMonth.duration = { weeks: maxWeeks }; }

        var calendar = new FullCalendar.Calendar(node, Object.assign(baseOpts, cfg));
        calendar.render();

        // Count the week rows that landed fully on screen (row height is content-
        // driven, so dense months fit fewer). Re-render with just those weeks so
        // the range — and the title — match what is actually visible.
        if (expandWeeksToFillHeight) {
          var gridBottom = node.getBoundingClientRect().bottom + 1;
          var weekRows = node.querySelectorAll('.fc-daygrid-body tr');
          var fitWeeks = 0;
          weekRows.forEach(function(tr){ if (tr.getBoundingClientRect().bottom <= gridBottom) fitWeeks++; });
          // Upstream keeps at least 4 weeks, so a busy month is cut off at the bottom.
          // "Busy weeks" setting: show only the weeks that fit, so every event stays
          // visible, or keep at least 3 and let each day end in "+N more".
          var capDays = settings.weekOverflow === 'more' && fitWeeks < 3;
          fitWeeks = Math.min(maxWeeks, Math.max(settings.weekOverflow === 'more' ? 3 : 1, fitWeeks));
          if (fitWeeks < weekRows.length) {
            calendar.destroy();
            cfg.views.rollingMonth.duration = { weeks: fitWeeks };
            if (capDays) cfg.dayMaxEvents = true;
            calendar = new FullCalendar.Calendar(node, Object.assign(baseOpts, cfg));
            calendar.render();
          }
        }

        if (built.errors.length) {
          var err = document.createElement('div');
          err.className = 'trmnl-calendar-error text--small';
          err.textContent = 'Could not load ' + built.errors.join('; ');
          node.parentNode.insertBefore(err, node);
        }

        // Title bar: the visible date range, the same text FullCalendar's toolbar would show
        var titleRange = (node.closest('.view') || document).querySelector('.title_bar [data-calendar-range]');
        if (titleRange) titleRange.textContent = calendar.view.title;

        node.setAttribute('data-initialized', 'true');

        // Hacky fix for bug shown in https://github.com/usetrmnl/core/pull/2951.
        // Month view multi-day reflow detector. FC writes inline `top:Npx`
        // on .fc-daygrid-event-harness-abs during render based on measured
        // cell heights, but doesn't recompute when cells reflow later (font
        // swap on hard refresh, late CSS, images). Watch per-cell event
        // containers and trigger updateSize() when any height changes.
        if (node.classList.contains('trmnl-calendar--month') && window.ResizeObserver) {
          var rerunPending = false;
          var lastHeights = new Map();
          var rerun = function() {
            if (rerunPending) return;
            rerunPending = true;
            requestAnimationFrame(function() {
              rerunPending = false;
              try { calendar.updateSize(); } catch (_) {}
            });
          };
          var ro = new ResizeObserver(function(entries) {
            var changed = false;
            for (var i = 0; i < entries.length; i++) {
              var el = entries[i].target;
              var h = Math.round(entries[i].contentRect.height);
              if (lastHeights.get(el) !== h) {
                lastHeights.set(el, h);
                changed = true;
              }
            }
            if (changed) rerun();
          });
          node.querySelectorAll('.fc-daygrid-day-events').forEach(function(el) {
            lastHeights.set(el, Math.round(el.getBoundingClientRect().height));
            ro.observe(el);
          });
          // Insurance for the font-swap reflow specifically:
          // some browsers may defer the per-cell ResizeObserver signal
          // longer than the global fonts `loadingdone` event.
          if (document.fonts && document.fonts.addEventListener) {
            document.fonts.addEventListener('loadingdone', rerun);
          }
        }
      });
    } catch (e) { console.error(e); }
  };

  // Auto-init on DOM ready
  document.addEventListener('DOMContentLoaded', function(){
    window.trmnlInitCalendars(document);
  });
</script>

{% comment %} The calendar markup, printed by each view (see full.liquid) {% endcomment %}
{% capture rolling_calendar %}
{% assign s = trmnl.plugin_settings.custom_fields_values %}
{% assign time_zone = s.time_zone | default: trmnl.user.time_zone_iana | default: "UTC" %}
{% assign locale = s.locale | default: "en" | strip %}
{% comment %} ICS feeds, else TRMNL plugins, replace the HA entities when set (see polling_url in settings.yml);
   on TRMNL.com the Plugin Merge dropdowns replace them all (below) {% endcomment %}
{% assign source = "ha" %}{% case s.trmnl_plugins %}{% when nil, "" %}{% else %}{% assign source = "trmnl" %}{% endcase %}
{% if s.ics_urls contains "/" %}{% assign source = "ics" %}{% endif %}
{% comment %}
  LaraPaper passes the payload as `data`: one calendar's response, or {IDX_0: ..., IDX_1: ...}
  for several. TRMNL and trmnlp have no `data` for several URLs, only IDX_0, IDX_1, ... at the
  top level, so collect those (up to ten; unused ones come out as null, which the JS reads as empty calendars).
{% endcomment %}
{% assign events_json = data | json %}
{% if IDX_0 %}{% unless data %}{% capture events_json %}{
    "IDX_0": {{ IDX_0 | json }}, "IDX_1": {{ IDX_1 | json }}, "IDX_2": {{ IDX_2 | json }}, "IDX_3": {{ IDX_3 | json }}, "IDX_4": {{ IDX_4 | json }},
    "IDX_5": {{ IDX_5 | json }}, "IDX_6": {{ IDX_6 | json }}, "IDX_7": {{ IDX_7 | json }}, "IDX_8": {{ IDX_8 | json }}, "IDX_9": {{ IDX_9 | json }}
}{% endcapture %}{% endunless %}{% endif %}
{% comment %} TRMNL.com's Plugin Merge dropdowns, collected by plugin/trmnl-com/merge.liquid {% endcomment %}
{% if merge_sources %}{% assign source = "merge" %}{% assign events_json = merge_json %}{% endif %}

{% if s.dither_greys == "yes" %}
  {% comment %}
    LaraPaper only dithers 1-/2-bit output when the page has an img with class
    "image-dither" (ImageGenerationService::markupContainsDitherImage). This hidden
    pixel is that switch; 4-bit output is dithered regardless.
  {% endcomment %}
  <img class="image-dither" src="data:image/gif;base64,R0lGODlhAQABAIAAAP///wAAACH5BAEAAAAALAAAAAABAAEAAAICRAEAOw==" alt="" style="display:none">
{% endif %}
<div class="layout layout--col layout--stretch">
  <div class="trmnl-calendar trmnl-calendar--month{% if s.highlight_today != 'no' %} highlight-today{% endif %}{% if s.shade_weekends != 'no' %} shade-weekends{% endif %}{% if s.fade_past_events != 'no' %} fade-past{% endif %}{% if s.dither_greys == 'yes' %} dither-greys{% endif %}"
       data-events="{{ events_json | escape }}"
       data-calendar-config='{
         "timeZoneName": {{ time_zone | json | escape }},
         "nowUtc": {{ trmnl.system.timestamp_utc | default: 0 }},
         "source": "{{ source }}",
         "calendarEntities": {% if source != "ha" %}""{% else %}{{ s.calendars | default: "" | json | escape }}{% endif %},
         "calendarPrefixes": {{ s.calendar_labels | default: "" | json | escape }},
         "calendarColors": {{ s.calendar_colors | default: "" | json | escape }},
         "ignoredPhrases": {{ s.ignored_phrases | default: "" | json | escape }},
         "ignoredPhrasesExactMatch": {{ s.ignored_phrases_exact_match | default: "" | json | escape }},
         "includePastEvents": {% if s.include_past_events == "no" %}false{% else %}true{% endif %},
         "rollingAdvancement": {{ s.rolling_advancement | default: "week" | json | escape }},
         "weekOverflow": {{ s.week_overflow | default: "fewer_weeks" | json | escape }},
         "firstDay": {{ s.first_day | default: 1 | plus: 0 }},
         "hour12": {% if s.time_format == "am/pm" %}true{% else %}false{% endif %},
         "displayEventTime": {% if s.include_event_time == "no" %}false{% else %}true{% endif %},
         "displayEventEnd": {% if s.display_event_end == "no" %}false{% else %}true{% endif %},
         "weekNumbers": {% if s.show_week_numbers == "yes" %}true{% else %}false{% endif %},
         "shadeWeekends": {% if s.shade_weekends == "no" %}false{% else %}true{% endif %},
         "ditherGreys": {% if s.dither_greys == "yes" %}true{% else %}false{% endif %},
         "locale": {{ locale | json | escape }}
       }'></div>
</div>
{% if s.month_header == "yes" %}
  <div class="title_bar">
    <img class="image image--adaptive" alt="" src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='2'%3E%3Crect x='3' y='5' width='18' height='16' rx='2'/%3E%3Cpath d='M3 10h18M8 3v4M16 3v4'/%3E%3C/svg%3E">
    <span class="title">{{ trmnl.plugin_settings.instance_name | default: "Calendar" | escape }}</span>
    <span class="instance" data-calendar-range></span>
  </div>
{% endif %}
{% endcapture %}
