{% comment %}
  Daily Forecast: Open-Meteo's daily forecast (polled JSON: daily.time, weather_code,
  temperature_2m_max/min, dated in the location's zone), one column per day. The Rolling
  Month Calendar reads the same data through Plugin Merge (payloadToCalendars in
  plugin/src/shared.liquid, with the same WMO code groups and icons). Each view prints
  `daily_forecast`; the narrow ones show fewer days.
{% endcomment %}
{% assign forecast = daily | default: data.daily %}
{% capture icon_sun %}<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>{% endcapture %}
{% capture icon_partly %}<path d="M8 3v1.5M3.5 8H2M4.8 4.8l1 1M12.2 4.8l-1 1"/><path d="M5.2 11.5A4 4 0 1 1 12 7.6"/><path d="M8 20h10a4 4 0 0 0 0-8 5.5 5.5 0 0 0-10.4 1.4A3.3 3.3 0 0 0 8 20z"/>{% endcapture %}
{% capture icon_cloud %}<path d="M7 19h10a4.5 4.5 0 0 0 .4-9A6 6 0 0 0 6 11a4 4 0 0 0 1 8z"/>{% endcapture %}
{% capture icon_fog %}<path d="M7 14h10a4 4 0 0 0 .4-8A6 6 0 0 0 6 7.5 3.5 3.5 0 0 0 7 14z"/><path d="M4 18h16M6 21.5h12"/>{% endcapture %}
{% capture icon_rain %}<path d="M7 15h10a4.5 4.5 0 0 0 .4-9A6 6 0 0 0 6 7a4 4 0 0 0 1 8z"/><path d="M8 18l-1 3M12 18l-1 3M16 18l-1 3"/>{% endcapture %}
{% capture icon_snow %}<path d="M7 15h10a4.5 4.5 0 0 0 .4-9A6 6 0 0 0 6 7a4 4 0 0 0 1 8z"/><path d="M8 19h.01M12 19h.01M16 19h.01M10 22h.01M14 22h.01" stroke-width="3"/>{% endcapture %}
{% capture icon_storm %}<path d="M7 15h10a4.5 4.5 0 0 0 .4-9A6 6 0 0 0 6 7a4 4 0 0 0 1 8z"/><path d="M13 14l-3 4h4l-3 4"/>{% endcapture %}

{% capture daily_forecast %}
<style>
  .daily-forecast { display: flex; align-items: flex-start; width: 100%; }
  .daily-forecast-day { flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; align-items: center; gap: 0.5rem; text-align: center; }
  .daily-forecast-icon { width: 60%; max-width: 6rem; aspect-ratio: 1; }
  .view--half_vertical .daily-forecast-day:nth-child(n+5),
  .view--quadrant .daily-forecast-day:nth-child(n+4) { display: none; }
</style>
<div class="layout layout--col layout--center">
  {% if forecast.time %}
    <div class="daily-forecast">
      {% for day in forecast.time limit: 7 %}
        {% assign i = forloop.index0 %}
        {% assign code = forecast.weather_code[i] | default: 3 | plus: 0 %}
        {% if code <= 1 %}{% assign icon = icon_sun %}{% assign words = "Sunny" %}
        {% elsif code == 2 %}{% assign icon = icon_partly %}{% assign words = "Partly cloudy" %}
        {% elsif code == 45 or code == 48 %}{% assign icon = icon_fog %}{% assign words = "Fog" %}
        {% elsif code >= 95 %}{% assign icon = icon_storm %}{% assign words = "Thunder" %}
        {% elsif code >= 71 and code <= 77 %}{% assign icon = icon_snow %}{% assign words = "Snow" %}
        {% elsif code == 85 or code == 86 %}{% assign icon = icon_snow %}{% assign words = "Snow" %}
        {% elsif code >= 51 and code <= 67 %}{% assign icon = icon_rain %}{% assign words = "Rain" %}
        {% elsif code >= 80 and code <= 82 %}{% assign icon = icon_rain %}{% assign words = "Showers" %}
        {% else %}{% assign icon = icon_cloud %}{% assign words = "Cloudy" %}{% endif %}
        <div class="daily-forecast-day">
          <span class="label">{{ day | date: "%a %-d" }}</span>
          <svg class="daily-forecast-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">{{ icon }}</svg>
          <span class="value value--small">{{ forecast.temperature_2m_max[i] | round }}°</span>
          <span class="label">{{ forecast.temperature_2m_min[i] | round }}°</span>
          <span class="description">{{ words }}</span>
        </div>
      {% endfor %}
    </div>
  {% elsif reason %}
    <p class="description">Open-Meteo: {{ reason | escape }}</p>
  {% else %}
    <p class="description">Set a latitude and longitude in the plugin's settings.</p>
  {% endif %}
</div>
<div class="title_bar">
  <span class="title">{{ trmnl.plugin_settings.instance_name | default: "Daily Forecast" | escape }}</span>
  <span class="instance">Open-Meteo</span>
</div>
{% endcapture %}
