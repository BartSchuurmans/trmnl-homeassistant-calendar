// The stand-in Home Assistant (worker.mjs). Cloudflare's Git integration deploys it from
// main with `npx wrangler deploy` in this folder; see README.md.
{
  "name": "trmnl-rolling-month-calendar-sample-server",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  // sample-data.mjs imports node:fs etc. for its command line only
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false
}
